# RipGuard (Solana) — Environment Variables
# Copy to .env.local and fill in values for local dev.

# Cluster: "devnet" (default) or "mainnet-beta"
NEXT_PUBLIC_SOLANA_NETWORK=devnet

# RPC endpoint. Public RPCs work for devnet; mainnet-beta is heavily
# rate-limited so set a Helius / Triton / Quicknode URL for prod.
# Defaults if unset:
#   devnet       → https://api.devnet.solana.com
#   mainnet-beta → https://api.mainnet-beta.solana.com
# NEXT_PUBLIC_SOLANA_RPC=https://devnet.helius-rpc.com/?api-key=...

# Treasury (broker-fee recipient). Leave unset on devnet — defaults to the
# all-zeros pubkey, which the TS-skim helper treats as "fee disabled."
# NEXT_PUBLIC_TREASURY_PUBKEY=YourTreasuryPubkey...

# USDC mint override. Defaults:
#   devnet       → 4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU (Circle devnet)
#   mainnet-beta → EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v (Circle USDC)
# NEXT_PUBLIC_USDC_MINT=...

# Priority fee per compute unit, in microLamports. Mainnet leaders skip txs
# with no CU price under contention — without one our 600k-CU txs miss the
# blockhash validity window. Default 50000 (≈30k lamports / ~$0.007 per tx).
# Bump if mainnet gets congested.
# NEXT_PUBLIC_PRIORITY_FEE_MICRO_LAMPORTS=50000
